/*
 * SnthX - Chocofi 3x5 Split Keyboard
 * derived from https://www.reddit.com/r/KeyboardLayouts/comments/18jefux/snth/
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&sl { release-after-ms = <125>; };

/ {
    combos {
        compatible = "zmk,combos";

        // Global defaults

        timeout-ms = <50>;
        require-prior-idle-ms = <100>;

        tab {
            bindings = <&kp TAB>;
            key-positions = <13 14>;
            layers = <0>;
            slow-release;
            timeout-ms = <75>;
            require-prior-idle-ms = <125>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <13 16>;
            layers = <0>;
        };

        capsw {
            bindings = <&caps_word>;
            key-positions = <16 19>;
            layers = <0>;
            timeout-ms = <30>;
        };

        ing {
            bindings = <&ing>;
            key-positions = <22 21>;
            layers = <0>;
            slow-release;
            timeout-ms = <75>;
            require-prior-idle-ms = <125>;
        };

        the {
            bindings = <&the>;
            key-positions = <15 16>;
            layers = <0>;
            slow-release;
            timeout-ms = <75>;
            require-prior-idle-ms = <125>;
        };

        then {
            bindings = <&then>;
            key-positions = <14 16 15>;
            layers = <0>;
            slow-release;
            timeout-ms = <75>;
            require-prior-idle-ms = <125>;
        };

        else {
            bindings = <&else>;
            key-positions = <21 20 19>;
            layers = <0>;
            slow-release;
            timeout-ms = <75>;
            require-prior-idle-ms = <125>;
        };

        and {
            bindings = <&and>;
            key-positions = <19 20>;
            layers = <0>;
            slow-release;
            timeout-ms = <75>;
            require-prior-idle-ms = <125>;
        };

        game_esc {
            bindings = <&kp ESC>;
            key-positions = <1 2>;
            layers = <5>;
        };
    };

    macros {
        qu: qu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Q &kp U>;
            label = "QU";
            tap-ms = <30>;
        };

        the: the {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp H &kp E &kp SPACE>;
            label = "THE";
            tap-ms = <30>;
        };

        then: then {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp H &kp E &kp N &kp SPACE>;
            label = "THEN";
            tap-ms = <30>;
        };

        else: else {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp E &kp L &kp S &kp E &kp SPACE>;
            label = "ELSE";
        };

        and: and {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp N &kp D &kp SPACE>;
            label = "AND";
            tap-ms = <30>;
        };

        ing: ing {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp I &kp N &kp G>;
            label = "ING";
        };

        hold_r: hold_e {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp R>;
            label = "HOLD_E";
            tap-ms = <10>;
            wait-ms = <0>;
        };

        hold_b: hold_b {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp B>;
            label = "HOLD_B";
            tap-ms = <10>;
            wait-ms = <0>;
        };

        tap_5: tap_5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N5>;
            label = "TAP_5";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        tap_2: tap_p {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N6>;
            label = "TAP_P";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        tap_3: tap_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N3>;
            label = "TAP_3";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        tap_7: tap_7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N7>;
            label = "TAP_7";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        tap_0: tap_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0>;
            label = "TAP_0";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        tap_r: tap_r {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp R>;
            label = "TAP_R";
        };

        tap_4: tap_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N4>;
            label = "TAP_4";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        tap_8: tap_8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N8>;
            label = "TAP_8";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        tap_9: tap_9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N9>;
            label = "TAP_9";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        tap_x: tap_x {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp X>;
            label = "TAP_X";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        tap_tab: tap_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TAB>;
            label = "TAP_TAB";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        tap_e: tap_e {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp E>;
            label = "TAP_E";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        tap_q: tap_q {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Q>;
            label = "TAP_Q";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        tap_i: tap_i {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp I>;
            label = "TAP_I";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        tap_m: tap_m {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M>;
            label = "TAP_M";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        caps: caps {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CAPS>;
            label = "CAPS";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        tap_v: tap_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp V>;
            label = "TAP_V";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        tap_c: tap_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C>;
            label = "TAP_C";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        tap_z: tap_z {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Z>;
            label = "TAP_Z";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        tap_6: tap_6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N6>;
            label = "TAP_6";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        tap_u: tap_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp U>;
            label = "TAP_U";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        tap_b: tap_b {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp B>;
            label = "TAP_B";
            tap-ms = <30>;
            wait-ms = <0>;
        };
    };

    behaviors {
        // Optimized mod-tap for home row

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <250>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <150>;
        };

        // Q with QU quick tap (outputs QU quickly, hold for just Q)

        lingerq: lingerq {
            compatible = "zmk,behavior-hold-tap";
            label = "LINGERQ";
            bindings = <&kp>, <&qu>;

            #binding-cells = <2>;
            tapping-term-ms = <100>;
            flavor = "tap-preferred";
        };

        // Optimized hold-tap for backspace/delete

        thmo: thumb_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "thumblayer";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;

            require-prior-idle-ms = <150>;
        };

        seven_mod: seven_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "SEVEN_MOD";
            bindings = <&kp>, <&tap_7>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        five_mod: five_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "FIVE_MOD";
            bindings = <&kp>, <&tap_5>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        four_mod: four_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "FOUR_MOD";
            bindings = <&kp>, <&tap_4>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        u_mod: u_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "U_MOD";
            bindings = <&kp>, <&tap_u>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        mapinv3: mapinv3 {
            compatible = "zmk,behavior-hold-tap";
            label = "MAPINV3";
            bindings = <&kp>, <&tap_tab>;

            #binding-cells = <2>;
            tapping-term-ms = <230>;
            flavor = "hold-preferred";
        };

        t3mtab: t3mtab {
            compatible = "zmk,behavior-tap-dance";
            label = "T3MTAB";
            #binding-cells = <0>;
            bindings = <&mapinv3 M 0>, <&tap_3>;

            tapping-term-ms = <220>;
        };

        run_walk: run_walk {
            compatible = "zmk,behavior-hold-tap";
            label = "RUN_WALK";
            bindings = <&kp>, <&caps>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        six_mod: six_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "SIX_MOD";
            bindings = <&kp>, <&tap_6>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        zero_mod: zero_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "ZERO_MOD";
            bindings = <&kp>, <&tap_0>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        nine_mod: nine_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "NINE_MOD";
            bindings = <&kp>, <&tap_9>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        eight_mod: eight_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "EIGHT_MOD";
            bindings = <&kp>, <&tap_8>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        three_mod: three_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "THREE_MOD";
            bindings = <&kp>, <&tap_3>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        altInv_3: altInv_3 {
            compatible = "zmk,behavior-hold-tap";
            label = "ALTINV_3";
            bindings = <&kp>, <&tap_tab>;

            #binding-cells = <2>;
            tapping-term-ms = <230>;
            flavor = "hold-preferred";
        };

        tapInv3: tapInv3 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAPINV3";
            #binding-cells = <0>;
            bindings = <&altInv_3 LALT 0>, <&tap_3>;

            tapping-term-ms = <220>;
        };

        b_mod: b_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "B_MOD";
            bindings = <&kp>, <&tap_b>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // BASE LAYER - BAGROK OPTIMIZED

        baz {
            bindings = <
&none  &kp F       &kp B       &kp K        &kp L        &kp J           &kp EQUAL  &kp W          &kp SQT      &kp SLASH   &kp PERIOD  &none
&none  &hm LGUI S  &hm LALT N  &hm LCTRL T  &hm LSHFT H  &kp V           &kp G      &hm RSHFT C    &hm RCTRL A  &hm RALT E  &hm RGUI I  &none
&none  &kp X       &kp P       &kp D        &kp M        &lingerq Q 0    &kp Z      &kp Y          &kp O        &kp U       &kp COMMA   &none
                               &mo 2        &thmo 4 R    &kp BSPC        &kp RET    &thmo 1 SPACE  &thmo 6 DEL
            >;
        };

        sym {
            bindings = <
&trans  &none     &none     &none     &none     &none        &kp TILDE  &kp GRAVE  &kp DQT   &kp BSLH   &kp COLON      &trans
&trans  &kp LBRC  &kp LPAR  &kp RPAR  &kp RBRC  &kp UNDER    &kp PIPE   &kp QMARK  &kp EXCL  &kp EQUAL  &kp AMPS       &trans
&trans  &kp LBKT  &kp LT    &kp GT    &kp RBKT  &kp CARET    &kp DLLR   &kp HASH   &kp AT    &kp PRCNT  &kp SEMICOLON  &trans
                            &tog 5    &trans    &trans       &trans     &trans     &trans
            >;
        };

        num {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &kp STAR   &kp N7  &kp N8  &kp N9  &kp PLUS   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp SLASH  &kp N4  &kp N5  &kp N6  &kp MINUS  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp DOT    &kp N1  &kp N2  &kp N3  &kp EQUAL  &trans
                        &trans  &trans  &trans    &kp TAB    &kp N0  &mo 3
            >;
        };

        fnk {
            bindings = <
&trans  &sys_reset  &bootloader  &none         &none         &none         &none         &kp F1  &kp F2   &kp F3   &kp F4   &trans
&trans  &kp C_PREV  &kp C_NEXT   &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PP      &kp C_BRI_UP  &kp F5  &kp F6   &kp F7   &kp F8   &trans
&trans  &none       &none        &bt BT_PRV    &bt BT_NXT    &bt BT_CLR    &kp C_BRI_DN  &kp F9  &kp F10  &kp F11  &kp F12  &trans
                                 &trans        &trans        &trans        &trans        &trans  &trans
            >;
        };

        mou {
            bindings = <
&trans  &kp ESC    &kp HOME  &kp UP    &kp END    &kp PG_UP    &trans  &trans     &msc SCRL_UP    &trans     &trans  &trans
&trans  &kp LSHFT  &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_DN    &trans  &mkp LCLK  &mkp MCLK       &mkp RCLK  &trans  &trans
&trans  &kp LCTRL  &kp LALT  &none     &none      &none        &trans  &trans     &msc SCRL_DOWN  &trans     &trans  &trans
                             &trans    &trans     &trans       &trans  &trans     &trans
            >;
        };

        gam {
            bindings = <
&trans  &three_mod TAB 0   &four_mod Q 0   &kp W       &five_mod E 0  &kp R            &kp GRAVE  &kp N7  &kp N8  &kp N9  &kp RGUI  &trans
&trans  &run_walk LSHFT 0  &kp A           &kp S       &kp D          &six_mod L 0     &kp Y      &kp N4  &kp N5  &kp N6  &kp N     &trans
&trans  &seven_mod LALT 0  &eight_mod Z 0  &u_mod X 0  &nine_mod C 0  &zero_mod V 0    &kp BSPC   &kp N1  &kp N2  &kp N3  &kp DOT   &trans
                                           &kp LCTRL   &kp SPACE      &b_mod M 0       &kp RET    &kp N0  &tog 5
            >;
        };

        lnx {
            bindings = <
&trans  &trans  &trans    &trans     &trans      &trans    &trans  &trans        &kp LG(UP)    &trans         &trans  &trans
&trans  &trans  &kp LALT  &kp LCTRL  &kp LSHIFT  &trans    &trans  &kp LG(LEFT)  &kp LG(DOWN)  &kp LG(RIGHT)  &trans  &trans
&trans  &trans  &trans    &trans     &trans      &trans    &trans  &trans        &trans        &trans         &trans  &trans
                          &mo 7      &trans      &trans    &trans  &trans        &trans
            >;
        };

        wrk {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &kp LG(N6)  &kp LG(N7)  &kp LG(N8)  &kp LG(N9)  &kp LG(N0)  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp LG(N1)  &kp LG(N2)  &kp LG(N3)  &kp LG(N4)  &kp LG(N5)  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans      &trans      &trans      &trans      &trans      &trans
                        &trans  &trans  &trans    &trans      &trans      &trans
            >;
        };
    };
};
